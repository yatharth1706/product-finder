# Backend
CORS_ORIGINS=["http://localhost:3000"]
REQUEST_TIMEOUT_SECONDS=15
# Whole search on one store, including opening product pages.
MARKETPLACE_TIMEOUT_SECONDS=30
# Product pages opened per store to fill in colour or stock.
MAX_DETAIL_PAGES=6
# "background" (POST /api/v1/search returns at once) or "inline" (waits; for serverless).
SEARCH_MODE=background
LOG_LEVEL=INFO

# Frontend (build-time)
NEXT_PUBLIC_API_URL=http://localhost:8000
